value="

* Circuit Parameters
.param vdd = 1.2
.param vss = 0.0
.param Tclk = 1375p
.param SRclk = 50p
.options rshunt = 1e12


* Include Models
.lib cornerMOSlv.lib mos_tt

* 	Initial Conditions
* Inputs and IOCells
*.nodeset v(x1.x1.x1[7].x1.tieh)=\{vdd\} v(x1.x1.x1[7].x1.tiel)=0 v(x1.x1.x1[7].x3.tieh)=\{vdd\} v(x1.x1.x1[7].x3.tiel)=0 v(x1.x1.x1[7].x5.tieh)=\{vdd\} v(x1.x1.x1[7].x5.tiel)=0
