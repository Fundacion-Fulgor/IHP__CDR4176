*.nodeset v(x2.x1.x1[2].x1.tieh)=\{vdd\} v(x2.x1.x1[2].x1.tiel)=0 v(x2.x1.x1[2].x3.tieh)=\{vdd\} v(x2.x1.x1[2].x3.tiel)=0 v(x2.x1.x1[2].x5.tieh)=\{vdd\} v(x2.x1.x1[2].x5.tiel)=0
*.nodeset v(x2.x1.x1[1].x1.tieh)=\{vdd\} v(x2.x1.x1[1].x1.tiel)=0 v(x2.x1.x1[1].x3.tieh)=\{vdd\} v(x2.x1.x1[1].x3.tiel)=0 v(x2.x1.x1[1].x5.tieh)=\{vdd\} v(x2.x1.x1[1].x5.tiel)=0
*.nodeset v(x2.x1.x1[0].x1.tieh)=\{vdd\} v(x2.x1.x1[0].x1.tiel)=0 v(x2.x1.x1[0].x3.tieh)=\{vdd\} v(x2.x1.x1[0].x3.tiel)=0 v(x2.x1.x1[0].x5.tieh)=\{vdd\} v(x2.x1.x1[0].x5.tiel)=0


* OP Parameters & Singals to save
.save v(vinI) v(vinQ) v(vinIB) v(vinQB) v(out1) v(out2) v(out3) v(out4) v(out1_pex) v(out2_pex) v(out3_pex) v(out4_pex) v(out3_pex_4_1) v(out4_pex_4_1) v(x1.tieh) v(x1.tiel) v(x2.tieh) v(x2.tiel) v(vcont1) v(vcont2) v(vcont3)

*Simulations
.control
*set output_path = tb_linearity_8xpi/
	*set ngdebug
	*set verbose
	tran 5PS 16NS
	*display
	*set filetype = ascii
        write tran_mux_2_1_pex.raw
	set filetype = ascii
        write tran_mux_2_1_pex_ascii.raw
	*V(vout) V(vout8i) V(vinI) V(vinIB) V(@x1.vsq[2]) V(x1.vst[7]) V(x1.vstq[7]) V(x1.x1.vini) V(x1.x1.vinib) V(x1.x1.vinq) V(x1.x1.vinqb)
	*write \{$output_path\}tran_linearity_termoless.raw V(Vout) V(Vout8I) V(vinI) V(VoutI1) V(VoutI2) V(VoutQ1) V(VoutIB1) V(VoutQB1)
.endc
.end"}
